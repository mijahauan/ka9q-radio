# Homebrew dependencies for building ka9q-radio on macOS
# Usage: brew bundle --file=src/Brewfile
#
# Note: the Makefile uses Homebrew if it is installed, falling back to
# MacPorts (/opt/local). Force a particular prefix with: make MACPREFIX=...
# See docs/INSTALL-macos.md for details.

brew "pkg-config"

# core libraries
brew "fftw"
brew "iniparser"
brew "libogg"
brew "libsamplerate"
brew "libusb"
brew "ncurses"
brew "opus"
brew "portaudio"

# SDR front end driver libraries -- all optional; on macOS each driver is
# built only if its library headers are found at build time.
# RX888 and funcube need only libusb/portaudio from the core set above.
brew "airspy"
brew "airspyhf"
brew "hackrf"
brew "librtlsdr"
brew "libbladerf"
# hydrasdr and fobos are not in Homebrew; build those libraries from source
# sdrplay requires the proprietary SDRplay API from sdrplay.com
